<section class="mx-auto max-w-md px-5 py-14">
  <h1 class="text-3xl font-bold text-slate-950">Create your workspace</h1>
  <p class="mt-2 text-slate-600">Start with an owner account and a private tenant.</p>
  <% if @user.errors.any? %><div class="mt-6 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800"><%= @user.errors.full_messages.to_sentence %></div><% end %>
  <%= form_with model: @user, url: registration_path, class: "mt-8 space-y-5" do |form| %>
    <div><%= form.label :name, class: "block text-sm font-medium" %><%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", class: "mt-2 w-full rounded-md border border-slate-300 px-3 py-2" %></div>
    <div><%= label_tag :account_name, "Workspace name", class: "block text-sm font-medium" %><%= text_field_tag :account_name, params[:account_name], required: true, class: "mt-2 w-full rounded-md border border-slate-300 px-3 py-2" %></div>
    <div><%= form.label :email_address, class: "block text-sm font-medium" %><%= form.email_field :email_address, required: true, autocomplete: "email", class: "mt-2 w-full rounded-md border border-slate-300 px-3 py-2" %></div>
    <div><%= form.label :password, class: "block text-sm font-medium" %><%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, class: "mt-2 w-full rounded-md border border-slate-300 px-3 py-2" %></div>
    <div><%= form.label :password_confirmation, class: "block text-sm font-medium" %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "mt-2 w-full rounded-md border border-slate-300 px-3 py-2" %></div>
    <%= form.submit "Create account", class: "w-full rounded-md bg-indigo-600 px-4 py-3 font-semibold text-white hover:bg-indigo-700" %>
  <% end %>
</section>
