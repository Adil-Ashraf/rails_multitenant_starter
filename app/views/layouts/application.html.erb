<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rails Multitenant Starter" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Rails Multitenant Starter">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4" aria-label="Main navigation">
        <%= link_to "Rails SaaS Starter", root_path, class: "font-semibold text-slate-950" %>
        <div class="flex items-center gap-4 text-sm">
          <% if authenticated? %>
            <span class="hidden text-slate-500 sm:inline"><%= current_account.name %></span>
            <%= button_to "Sign out", session_path, method: :delete, class: "font-medium text-slate-700 hover:text-slate-950" %>
          <% else %>
            <%= link_to "Sign in", new_session_path, class: "font-medium text-slate-700 hover:text-slate-950" %>
            <%= link_to "Create account", new_registration_path, class: "rounded-md bg-indigo-600 px-4 py-2 font-semibold text-white hover:bg-indigo-700" %>
          <% end %>
        </div>
      </nav>
    </header>
    <main>
      <% flash.each do |type, message| %>
        <div class="mx-auto mt-5 max-w-3xl rounded-md border px-4 py-3 text-sm <%= type == 'alert' ? 'border-red-200 bg-red-50 text-red-800' : 'border-emerald-200 bg-emerald-50 text-emerald-800' %>"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
