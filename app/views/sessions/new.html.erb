<section class="mx-auto max-w-md px-5 py-14">
  <h1 class="text-3xl font-bold text-slate-950">Welcome back</h1>
  <p class="mt-2 text-slate-600">Sign in to your workspace.</p>
  <%= form_with url: session_path, class: "mt-8 space-y-5" do |form| %>
    <div><%= form.label :email_address, class: "block text-sm font-medium" %><%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", class: "mt-2 w-full rounded-md border border-slate-300 px-3 py-2" %></div>
    <div><%= form.label :password, class: "block text-sm font-medium" %><%= form.password_field :password, required: true, autocomplete: "current-password", class: "mt-2 w-full rounded-md border border-slate-300 px-3 py-2" %></div>
    <%= form.submit "Sign in", class: "w-full rounded-md bg-indigo-600 px-4 py-3 font-semibold text-white hover:bg-indigo-700" %>
  <% end %>
</section>
